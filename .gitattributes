# GBNF-грамматика (ADR-004) ДОЛЖНА оставаться с LF-переносами: парсер llama.cpp
# чувствителен к структуре строк, а CRLF (git autocrlf на Windows) ранее уже
# приводил к тому, что грамматика не парсилась и первый LLM-инференс падал
# сегфолтом (2026-07-21). Форсируем LF на всех платформах.
*.gbnf text eol=lf

# Gradle wrapper script — только LF, иначе ломается на Unix-хостах.
gradlew text eol=lf
