<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <!-- Шапка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="4dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_shield"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/app_name"
                android:textColor="?attr/colorOnSurface"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Сводка: защищён ли пользователь. Цвет и текст меняет MainActivity.updateSummary() -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/textSummaryTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textSummarySubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp"
                    android:lineSpacingExtra="2dp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:max="6"
                    app:trackThickness="8dp"
                    app:trackCornerRadius="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Shield.SectionHeader"
            android:text="@string/section_access" />

        <!-- Доступ к уведомлениям -->
        <com.google.android.material.card.MaterialCardView style="@style/Shield.Card">
            <LinearLayout style="@style/Shield.CardRow">
                <LinearLayout style="@style/Shield.CardText">
                    <TextView style="@style/Shield.CardTitle" android:text="@string/grant_notifications" />
                    <TextView style="@style/Shield.CardHint" android:text="@string/hint_notifications" />
                    <TextView android:id="@+id/statusNotifications" style="@style/Shield.CardStatus" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNotifications"
                    style="@style/Shield.CardButton"
                    android:text="@string/action_enable" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Экран вызовов -->
        <com.google.android.material.card.MaterialCardView style="@style/Shield.Card">
            <LinearLayout style="@style/Shield.CardRow">
                <LinearLayout style="@style/Shield.CardText">
                    <TextView style="@style/Shield.CardTitle" android:text="@string/grant_call_role" />
                    <TextView style="@style/Shield.CardHint" android:text="@string/hint_call_role" />
                    <TextView android:id="@+id/statusCallRole" style="@style/Shield.CardStatus" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCallRole"
                    style="@style/Shield.CardButton"
                    android:text="@string/action_enable" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Показ уведомлений -->
        <com.google.android.material.card.MaterialCardView style="@style/Shield.Card">
            <LinearLayout style="@style/Shield.CardRow">
                <LinearLayout style="@style/Shield.CardText">
                    <TextView style="@style/Shield.CardTitle" android:text="@string/grant_post_notif" />
                    <TextView style="@style/Shield.CardHint" android:text="@string/hint_post_notif" />
                    <TextView android:id="@+id/statusPostNotif" style="@style/Shield.CardStatus" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPostNotif"
                    style="@style/Shield.CardButton"
                    android:text="@string/action_enable" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Контакты -->
        <com.google.android.material.card.MaterialCardView style="@style/Shield.Card">
            <LinearLayout style="@style/Shield.CardRow">
                <LinearLayout style="@style/Shield.CardText">
                    <TextView style="@style/Shield.CardTitle" android:text="@string/grant_contacts" />
                    <TextView style="@style/Shield.CardHint" android:text="@string/hint_contacts" />
                    <TextView android:id="@+id/statusContacts" style="@style/Shield.CardStatus" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnContacts"
                    style="@style/Shield.CardButton"
                    android:text="@string/action_enable" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Состояние звонка -->
        <com.google.android.material.card.MaterialCardView style="@style/Shield.Card">
            <LinearLayout style="@style/Shield.CardRow">
                <LinearLayout style="@style/Shield.CardText">
                    <TextView style="@style/Shield.CardTitle" android:text="@string/grant_phone_state" />
                    <TextView style="@style/Shield.CardHint" android:text="@string/hint_phone_state" />
                    <TextView android:id="@+id/statusPhoneState" style="@style/Shield.CardStatus" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPhoneState"
                    style="@style/Shield.CardButton"
                    android:text="@string/action_enable" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Статистика использования -->
        <com.google.android.material.card.MaterialCardView style="@style/Shield.Card">
            <LinearLayout style="@style/Shield.CardRow">
                <LinearLayout style="@style/Shield.CardText">
                    <TextView style="@style/Shield.CardTitle" android:text="@string/grant_usage" />
                    <TextView style="@style/Shield.CardHint" android:text="@string/hint_usage" />
                    <TextView android:id="@+id/statusUsage" style="@style/Shield.CardStatus" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUsage"
                    style="@style/Shield.CardButton"
                    android:text="@string/action_enable" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Наблюдение за приложениями -->
        <TextView
            style="@style/Shield.SectionHeader"
            android:text="@string/section_watched" />

        <com.google.android.material.card.MaterialCardView style="@style/Shield.Card">
            <LinearLayout style="@style/Shield.CardRow">
                <LinearLayout style="@style/Shield.CardText">
                    <TextView style="@style/Shield.CardTitle" android:text="@string/watched_title" />
                    <TextView style="@style/Shield.CardHint" android:text="@string/watched_hint" />
                    <TextView android:id="@+id/statusWatched" style="@style/Shield.CardStatus" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWatchedApps"
                    style="@style/Shield.CardButton"
                    android:text="@string/action_configure" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Модель ИИ -->
        <TextView
            style="@style/Shield.SectionHeader"
            android:text="@string/section_model" />

        <com.google.android.material.card.MaterialCardView style="@style/Shield.Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <LinearLayout style="@style/Shield.CardText">
                        <TextView style="@style/Shield.CardTitle" android:text="@string/model_title" />
                        <TextView android:id="@+id/statusModel" style="@style/Shield.CardStatus" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModelDownload"
                        style="@style/Shield.CardButton"
                        android:text="@string/model_download" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:trackThickness="6dp"
                    app:trackCornerRadius="3dp" />

                <TextView
                    style="@style/Shield.CardHint"
                    android:layout_marginTop="10dp"
                    android:text="@string/model_consent_hint" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchWifiOnly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:minHeight="52dp"
                    android:checked="true"
                    android:textSize="15sp"
                    android:text="@string/model_wifi_only" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Проверка -->
        <TextView
            style="@style/Shield.SectionHeader"
            android:text="@string/section_check" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDemo"
            style="@style/Shield.WideButton"
            android:text="@string/run_demo"
            app:icon="@drawable/ic_shield" />

        <TextView
            style="@style/Shield.CardHint"
            android:layout_marginTop="6dp"
            android:layout_marginStart="4dp"
            android:text="@string/run_demo_hint" />

        <!-- Диагностика -->
        <TextView
            style="@style/Shield.SectionHeader"
            android:text="@string/section_diagnostics" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShowLog"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="@string/show_log"
            app:icon="@android:drawable/ic_menu_recent_history"
            app:iconGravity="textStart" />

    </LinearLayout>
</ScrollView>
